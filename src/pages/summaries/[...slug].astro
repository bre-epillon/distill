---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { KIND_LABEL } from '../../lib/relations';

export async function getStaticPaths() {
  const summaries = (await getCollection('summaries')).filter(
    (s) => !s.data.draft,
  );
  return summaries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

// Atomic notes live in their own collection, so a book's principles are a
// query rather than duplicated frontmatter.
const notes = (await getCollection('notes'))
  .filter((n) => !n.data.draft && n.data.sources.includes(entry.id))
  .sort((a, b) => a.id.localeCompare(b.id));

// Resolve connection slugs → titles so we can render nice link cards.
const all = await getCollection('summaries');
const bySlug = new Map(all.map((s) => [s.id, s.data]));
const connections = d.connections
  .map((c) => ({ ...c, target: bySlug.get(c.slug) }))
  .filter((c) => c.target);

const fmt = (dt?: Date) =>
  dt
    ? new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric' }).format(
        dt,
      )
    : null;
const stars = d.rating ? '★'.repeat(d.rating) + '☆'.repeat(5 - d.rating) : null;
---

<BaseLayout title={`${d.title} — Distil`} description={d.oneLine}>
  <article class="reader" style={`--accent:${d.accent}`}>
    <a class="back" href="/">← Library</a>

    <span class="kicker">{d.cover} {d.author}</span>
    <h1>{d.title}</h1>

    <p class="oneline">{d.oneLine}</p>

    <div class="readmeta">
      <span>{KIND_LABEL[d.kind]}</span>
      <span>{d.readingTime} min read</span>
      {stars && <span style={`color:${d.accent}`}>{stars}</span>}
      {d.readDate && <span>Read {fmt(d.readDate)}</span>}
      {
        d.sourceUrl && (
          <a
            class="chip neutral"
            href={d.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Original ↗
          </a>
        )
      }
      <div class="chips" style="gap:6px">
        {d.topics.map((t) => (
          <a class="chip" href={`/topics/${t.replace(/\s+/g, '-').toLowerCase()}/`}>
            {t}
          </a>
        ))}
      </div>
    </div>

    <div class="prose">
      <Content />
    </div>

    {
      notes.length > 0 && (
        <div class="panel">
          <h2>Key principles</h2>
          <p class="panel-sub">
            Atomic notes — each one is a node in the <a href="/graph">graph</a>.
          </p>
          {notes.map((p, i) => (
            <a class="principle principle-link" href={`/notes/${p.id}/`}>
              <span class="num">{i + 1}</span>
              <p class="ptext">
                {p.data.claim}
                <span class="pid">
                  #{p.id}
                  {p.data.links.length > 0 &&
                    ` · ${p.data.links.length} link${p.data.links.length === 1 ? '' : 's'}`}
                </span>
              </p>
            </a>
          ))}
        </div>
      )
    }

    {
      connections.length > 0 && (
        <div class="panel">
          <h2>Connections</h2>
          <p class="panel-sub">
            How this book talks to others in the library.
          </p>
          {connections.map((c) => (
            <a class="connection" href={`/summaries/${c.slug}/`}>
              <span class="ctitle">
                {c.target.cover} {c.target.title}
                <span class="muted" style="font-weight:400">
                  · {c.target.author}
                </span>
              </span>
              <p class="cnote">{c.note}</p>
            </a>
          ))}
        </div>
      )
    }
  </article>
</BaseLayout>
